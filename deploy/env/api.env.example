NODE_ENV=production
PORT=3001

# Misma URL que usa el front en el navegador (links en emails)
APP_URL=https://app.tudominio.com

# Orígenes CORS (opcional si coincide con APP_URL). Varios: https://a.com,https://b.com
# CORS_ORIGIN=https://app.tudominio.com

# Misma contraseña que POSTGRES_PASSWORD en .env.stack (ver con: grep POSTGRES_PASSWORD .env.stack)
DATABASE_URL=postgresql://pickandsurvive:PEGAR_PASSWORD_DE_env_stack@127.0.0.1:5432/pickandsurvive

JWT_SECRET=cambiar_por_otro_secreto_largo

# Email (elige proveedor según tu código)
# RESEND_API_KEY=
# EMAIL_PROVIDER=resend
# GMAIL_SMTP_USER=
# GMAIL_SMTP_PASS=
