# Build: docker build -f deploy/docker/Dockerfile.api -t pickandsurvive-api .
FROM node:20-bookworm-slim AS builder
WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @pickandsurvive/api exec prisma generate
RUN pnpm --filter @pickandsurvive/api run build
RUN pnpm prune --prod

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9 --activate

COPY --from=builder /app /app
COPY deploy/docker/docker-api-entrypoint.sh /app/deploy/docker/docker-api-entrypoint.sh
RUN chmod +x /app/deploy/docker/docker-api-entrypoint.sh

WORKDIR /app/apps/api
EXPOSE 3001
ENTRYPOINT ["/app/deploy/docker/docker-api-entrypoint.sh"]
